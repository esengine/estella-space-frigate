#pragma shader "Atmospheric Entry"
#pragma version 300 es
#pragma domain Unlit
#pragma feature MESH_LOCAL_POSITION
#pragma param u_hot color default(1,0.9,0.7,1)
#pragma param u_ember color default(1,0.3,0.05,1)
#pragma param u_mist color default(0.9,0.94,1,1)
#pragma param u_heat float default(0) range(0,1)
#pragma param u_cloud float default(0) range(0,1)
#pragma param u_travel float default(0) range(0,100000)
#pragma param u_glow float default(2.4) range(0,8)
#pragma param u_half float default(2600) range(1,10000)
#pragma param u_eye vec3 default(0,40,-160)
#pragma param u_look vec3 default(0,0,1)
#pragma param u_hull vec3 default(42,56,76)
#pragma param u_hullAt vec3 default(0,10,2)
#pragma param u_near float default(1) range(0.01,100)
#pragma param u_far float default(30000) range(10,1000000)

#pragma fragment
precision highp float;

in vec4 v_color;
in vec2 v_texCoord;
#ifdef MESH_LOCAL_POSITION
in highp vec3 v_localPos;
#endif

out vec4 fragColor;

float cell(vec2 p) {
    return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

// Value noise that comes round on itself across `wrap` cells of x, so the sheath it is drawn on has no seam.
float cloud(vec2 p, float wrap) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    float x0 = mod(i.x, wrap), x1 = mod(i.x + 1.0, wrap);
    return mix(mix(cell(vec2(x0, i.y)), cell(vec2(x1, i.y)), u.x), mix(cell(vec2(x0, i.y + 1.0)), cell(vec2(x1, i.y + 1.0)), u.x), u.y);
}

float billow(vec2 p, float wrap) {
    float sum = 0.0, weight = 0.5;
    for (int octave = 0; octave < 4; octave++) {
        sum += weight * cloud(p, wrap);
        p = vec2(p.x * 2.0, p.y * 2.0 + 17.3);
        wrap *= 2.0;
        weight *= 0.5;
    }
    return sum;
}

// Threads of burning air torn back along the hull: each column has its own pace, length and width.
float streaks(float turn, float along, float columns, float stretch, float seed) {
    float column = turn * columns;
    float id = floor(column);
    float across = fract(column) - 0.5;
    float speed = 0.6 + 0.8 * cell(vec2(id, seed));
    float phase = fract(along / stretch + u_travel * speed / stretch + cell(vec2(id, seed + 7.0)));
    float keep = step(0.35, cell(vec2(id, seed + 13.0)));
    float tail = pow(1.0 - phase, 3.0) * smoothstep(0.0, 0.03, phase);
    float width = 0.12 + 0.28 * cell(vec2(id, seed + 19.0));
    return keep * tail * exp(-(across * across) / (width * width));
}

void main() {
    vec3 at = vec3(0.0, 1.0, 0.0);
#ifdef MESH_LOCAL_POSITION
    at = v_localPos;
#endif
    float turn = atan(at.y, at.x) / 6.2831853 + 0.5;
    float along = at.z;
    float bow = smoothstep(-0.35, 0.85, along / u_half);

    // The heat of entry: a glow that gathers ahead of her, tongues of it licking back, and bright threads through them.
    float lines = streaks(turn, along, 46.0, 1500.0, 3.0) + 0.7 * streaks(turn, along, 110.0, 900.0, 41.0);
    float tongues = billow(vec2(turn * 12.0, (along + u_travel * 1.25) / 420.0), 12.0);
    float flicker = 0.85 + 0.15 * cloud(vec2(turn * 6.0, u_travel / 90.0), 6.0);
    float plasma = u_heat * flicker * (0.12 + 0.88 * bow) * (0.55 * smoothstep(0.3, 0.8, tongues) + 0.8 * lines + 0.45 * bow * bow);
    vec3 fire = mix(u_ember.rgb, u_hot.rgb, clamp(plasma * 1.1 + lines * 0.5, 0.0, 1.0)) * (1.0 + u_glow * plasma);
    float fireCover = clamp(plasma * 1.15, 0.0, 0.88);

    // The cloud deck: banks of it streaming past, ragged at first, then all there is to see, then torn open again.
    float banks = billow(vec2(turn * 5.0, (along + u_travel) / 620.0), 5.0);
    float wisps = billow(vec2(turn * 14.0, (along + u_travel * 1.7) / 210.0), 14.0);
    float body = mix(banks, wisps, 0.35);
    float mistCover = smoothstep(0.0, 1.0, u_cloud * 2.3 - (1.0 - body) * 1.3);
    vec3 mist = u_mist.rgb * (0.7 + 0.42 * body);

    fragColor = vec4(mix(fire, mist, mistCover), clamp(fireCover * (1.0 - mistCover) + mistCover, 0.0, 1.0));

    // This air is round the ship and in front of the world: a planet she is skimming is nearer than the sheath it is drawn on,
    // and would hide it. So it is given the depth of the far side of a ball about the hull along each line of sight, which
    // puts it behind every part of her and before everything beyond her; where a line of sight misses the ball it is before all.
    vec3 ray = normalize(at - u_eye);
    // The ball is drawn out to the hull's own length, beam and height, so that it is hers and little else's.
    vec3 from = (u_eye - u_hullAt) / u_hull, way = ray / u_hull;
    float spread = dot(way, way), toward = dot(from, way);
    float inside = toward * toward - spread * (dot(from, from) - 1.0);
    float depth = 0.0;
    if (inside > 0.0) {
        float reach = (-toward + sqrt(inside)) / spread;
        if (reach > 0.0) {
            float ahead = max(reach * dot(ray, normalize(u_look)), u_near);
            depth = u_far * (ahead - u_near) / (ahead * (u_far - u_near));
        }
    }
    gl_FragDepth = depth;
}
#pragma end
