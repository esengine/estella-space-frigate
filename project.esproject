{
  "formatVersion": "1",
  "name": "Space Frigate",
  "description": "A frigate on patrol off a gas giant, built from a recipe: its hull, plating, worn paint, windows and engines are steps in a model source, and the nebula, planet and stars are generated.",
  "tag": "3D",
  "version": "0.1.0",
  "defaultScene": "assets/scenes/boot.esscene",
  "designResolution": { "width": 1600, "height": 900 },
  "spineVersion": "none",
  "scripts": { "main": "src/main.ts" },
  "assetExclude": ["tools", "proto", "server", "server-data", "tests"],
  "tools": { "protobuf": { "enabled": true } },
  "server": { "entry": "server/main.ts", "path": "/sector", "port": 8090, "args": ["--port", "{port}", "--host", "{host}", "--data", "{data}/sector.json", "--accounts", "{data}/pilots.json"], "health": "/healthz" },
  "packaging": { "platforms": { "web": { "connect": ["ws:", "wss:"] } } },
  "features": { "runtime": { "assetLoadTimeout": 180000 }, "rendering": { "colorSpace": "linear", "outputTransform": "aces", "quality": { "mode": "auto", "asyncShaderCompile": true, "profiles": { "low": { "textureStreaming": false, "depthPrepass": true }, "medium": { "textureStreaming": false } }, "deviceRules": [{"level": "low", "gpuIncludes": "Adreno"}, {"level": "low", "gpuIncludes": "Mali"}, {"level": "low", "gpuIncludes": "PowerVR"}, {"level": "low", "gpuIncludes": "Xclipse"}, {"level": "low", "gpuIncludes": "Immortalis"}, {"level": "low", "gpuIncludes": "Maleoon"}, {"level": "low", "gpuIncludes": "Apple GPU"}, {"level": "high", "gpuIncludes": "NVIDIA"}, {"level": "high", "gpuIncludes": "Radeon"}] } } }
}
