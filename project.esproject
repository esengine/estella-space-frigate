  "assetExclude": ["tools"],
  "features": { "runtime": { "assetLoadTimeout": 180000 }, "rendering": { "colorSpace": "linear", "outputTransform": "aces", "quality": { "mode": "auto", "asyncShaderCompile": true, "deviceRules": [{"level": "medium", "gpuIncludes": "Adreno"}, {"level": "medium", "gpuIncludes": "Mali"}, {"level": "medium", "gpuIncludes": "PowerVR"}, {"level": "medium", "gpuIncludes": "Xclipse"}, {"level": "medium", "gpuIncludes": "Immortalis"}, {"level": "medium", "gpuIncludes": "Maleoon"}, {"level": "medium", "gpuIncludes": "Apple GPU"}, {"level": "high"}] } } }
